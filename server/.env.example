NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mentor_mentee_v1

JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5000
UPLOAD_DIR=uploads

# Email Provider Selection: 'smtp' or 'resend'
EMAIL_PROVIDER=smtp

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Haridwar University <your_email@gmail.com>

# Resend Email Configuration (Fallback / Alternative)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Haridwar University <onboarding@resend.dev>
